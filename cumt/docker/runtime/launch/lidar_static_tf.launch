<?xml version="1.0"?>
<launch>
  <!--
    CUMT 三雷达静态外参配置。

    参数顺序（tf2_ros/static_transform_publisher）：
      x y z yaw pitch roll parent_frame child_frame

    单位：
      x/y/z 使用米，yaw/pitch/roll 使用弧度。

    TF 树：
      base_link -> lidar2
      lidar2    -> lidar1
      lidar2    -> lidar3

    base_link 为水平坐标系（Z 向上），原点暂放 lidar2。
    base_link->lidar2 吸收 lidar2 约 24.62° 的安装俯仰。
    lidar2->lidar3 使用当前最新两雷达标定结果。
    lidar2->lidar1 由原现场 lidar1->lidar2 标定外参取逆得到。
  -->

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="base_link_to_lidar2"
        args="0 0 0 0 0.4296 0 base_link lidar2" />

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="lidar2_to_lidar1"
        args="-0.821906788 -2.212231178 -0.291338761 -1.603675518 -0.003970140 0.232085245 lidar2 lidar1" />

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="lidar2_to_lidar3"
        args="0.658428 27.175900 -2.098440 0.00105 -0.00122 0.0241 lidar2 lidar3" />
</launch>
